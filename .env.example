# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by .gitignore.

# --- Supabase (client) --------------------------------------------------
# Public project URL and anon/publishable key. Safe to expose to the
# browser; row-level security enforces what these can actually read/write.
# Used by: src/integrations/supabase/client.ts, src/lib/supabase.ts
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server) ---------------------------------------------------
# Same project URL, server-side copies. SUPABASE_PUBLISHABLE_KEY backs the
# authenticated request middleware; SUPABASE_SERVICE_ROLE_KEY bypasses RLS
# entirely, so it must only ever be read on the server — never prefix it
# with VITE_ or send it to the browser.
# Used by: src/integrations/supabase/auth-middleware.ts (SUPABASE_PUBLISHABLE_KEY),
#          src/integrations/supabase/client.server.ts (SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Face-shape analysis & recommendations (client-side, free) ----------
# The default face analysis provider (src/services/ai/mediapipeFaceAnalysisProvider.ts)
# runs entirely in the browser via MediaPipe Face Landmarker. It needs NO API
# key and sends no image data anywhere — nothing to configure here. The
# recommendation engine (frame/size/colour matching) is also pure local
# logic against your product catalog. Lovable AI vision analysis remains
# available as an alternate provider (see LOVABLE_API_KEY below) if you
# prefer a vision-model-based analysis instead of the on-device one.

# --- AI Shopping Assistant (server only, pick ONE provider) --------------
# Three interchangeable backends are implemented; the assistant auto-selects
# one at request time based on which key below is set (see priority order
# in src/lib/ai/assistantOrchestrator.server.ts). Set AI_PROVIDER to force a
# specific backend instead of relying on auto-detection.
#   Priority when AI_PROVIDER is unset: OPENROUTER_API_KEY > GEMINI_API_KEY > LOVABLE_API_KEY
#
# Option A — OpenRouter (also routes to Gemini models by model id):
#   Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, defaults to google/gemini-2.5-flash. Any OpenRouter model id
# that supports tool calling works, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet.
OPENROUTER_MODEL=
#
# Option B — Google Gemini, called directly:
#   Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash.
GEMINI_MODEL=
#
# Option C — Lovable AI gateway (see LOVABLE_API_KEY further down — it also
# powers virtual try-on unconditionally, so if you're already setting it for
# that, the assistant will use it automatically as a fallback):
#
# Force a specific backend instead of auto-detecting from the keys above:
# lovable | openrouter | gemini
AI_PROVIDER=

# --- Lovable AI gateway (server only) ------------------------------------
# Also powers, unconditionally (no alternate provider yet):
#   - AI Virtual Try-On       (src/lib/ai/tryOnImage.server.ts)
# And, as an alternate to the on-device analyzer above:
#   - AI Face-shape analysis  (src/lib/ai/faceAnalysis.server.ts)
# Without this key set, virtual try-on fails gracefully with a clear
# "not configured" error instead of crashing. Get a key from
# https://lovable.dev (Lovable AI gateway). Never expose this to the
# client; it is only read inside TanStack Start server functions
# (process.env, not import.meta.env).
LOVABLE_API_KEY=
